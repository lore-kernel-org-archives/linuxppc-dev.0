 filename="np.sh"

## summary mode
s=1;
myecho() {
	if [[ $s == 0 ]];then
		echo $@
	fi
}

foo() {
	local t=$1;
	##detail log
	local n="$0.log";

	myecho $t Concurrent Runners

	echo -n > $n
	for ((j=0;j<$t;j++))
	do {
		local str=`netperf -t TCP_RR -l 20 -s 1 -P 0 -H 9.40.195.16`
		myecho $str
		echo $str|awk '{print $6}' >> $n
	}& done
	wait

	local sum=`cat $n|awk '{sum += $1} END {print sum}'`
	local delta=`cat $n|awk '{a[i++]=$1;} END{for(i in a) sum += a[i]; ave=sum/length(a); for(i in a) delta += (a[i]-ave)*(a[i]-ave); print delta/length(a);}'`

	myecho "total throughput is" 
	echo $sum $delta
	myecho "done"
}

for ((i=$1;i<$2;i++))
{
	if [[ x"$3" != "xs" ]];then
		s=0 ##turn off summary mode;
		foo $i ## direct echo
	else
		r=`foo $i` ## all in one line
		if [[ x"$4" != x ]];then
			echo "$i $r" |tee -a $4
		else 
			echo "$i $r"
		fi
	fi
}


