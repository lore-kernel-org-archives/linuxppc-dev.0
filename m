			SysACE_CompactFlash: opb-sysace@41800000 {
				compatible = "xlnx,opb-sysace-1.00.c";
				interrupt-parent = <&opb_intc_0>;
				interrupts = < 3 0 >;
				reg = < 41800000 10000 >;
