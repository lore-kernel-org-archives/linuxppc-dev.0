@@ -152,6 +152,7 @@
         int wol_irq;
 	volatile emac_t *emacp;
 	struct ocp_device *ocpdev;
+	struct ocp_func_emac_data *emacdata;
         struct net_device *ndev;
         spinlock_t lock;
 };
