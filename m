#include <stdio.h>
#include <stdlib.h>
#include <ctype.h>
#include <sys/types.h>
#include <sys/fcntl.h>
#include <sys/mman.h>

/* SJS apparently not used =

static inline void eieio()
{
   asm volatile("eieio" : :);
} */

unsigned long regs;

/************************************************************************=
/
static inline unsigned int ld(int regno)
{
    unsigned int x;

    asm volatile ("lwbrx %0,0,%1; eieio" : "=3Dr" (x) : "r" (regs + regno=
));
    return x;
}

/************************************************************************=
/
static inline void st(int regno, unsigned int x)
{
    asm volatile ("stwbrx %0,0,%1; eieio" : : "r" (x), "r" (regs + regno)=
);
}

/************************************************************************=
/
static void print_usage(void)
{
  printf("Usage =3D mirror2 [-h ][-o mirror_level ][-m offset]\n");
  printf("  -h Help/ print usage\n");
  printf("  -o Set mirroring to mirror_level (0=3Doff 1=3Don ?)\n");
  printf("  -m PCI offset for device as a Hex number\n");
}


/************************************************************************=
/
static void get_arguments(int ac, char **av,int *on,unsigned long *offset=
)
{
  int arg;
  char *thisArg;
  =

  /* defaults */
  *on=3D1;
  *offset=3D0xa0000000;
  =

  if(ac=3D=3D1)
  {
     print_usage();
  }
  for(arg=3D1;arg<ac;arg++)
  {
     thisArg=3Dav[arg];
     if(thisArg[0]=3D=3D'-')
     {
        switch(tolower(thisArg[1]))
        {
        case 'o':
           *on=3D1;
           if(arg+1<ac)
           {
                arg++;
                *on=3Datoi(av[arg]);
                printf("Mirroring level =3D %d\n",*on);
           }
           break;
        case 'm':
           if(arg+1<ac)
           {
                arg++;
                sscanf(av[arg],"%lx",offset);
                printf("Mirror Offset =3D %lX\n",*offset);
           }
           break;
        case 'h':
           print_usage();
           break;
        }
     }
  }
}

/************************************************************************=
/
int main(int ac, char **av)
{
    int fd, on;
    int a, x;
    unsigned long memoryOffset=3D0x81000000;
    =

    if ((fd =3D open("/dev/mem", O_RDWR)) < 0) {
         perror("/dev/mem");
         exit(1);
    }

    get_arguments(ac,av,&on,&memoryOffset);

    regs =3D (unsigned long)
        mmap(0, 0x1000, PROT_READ|PROT_WRITE, MAP_SHARED, fd, memoryOffse=
t);
    if (regs =3D=3D -1) {
         perror("mmap");
         exit(1);
    }

    st(0x300, ld(0x200));
    st(0x304, ld(0x204));
    st(0x308, ld(0x208));
    st(0x30c, ld(0x20c));
    st(0x324, ld(0x224));
    st(0x32c, ld(0x22c));

    st(0x3f8, on? ((ld(0x50) & 0x700) | 0x2210000): 0x4000000);

    st(0x3e0, ld(0x2e0));
    st(0x3e4, ld(0x2e4));

    x =3D ld(0x8) & ~0xff;
    st(0x8, x | 2);
    a =3D ld(0x9);
    st(0x8, x | 0xaa);
    st(0x9, a & ~0x20000);

    st(0x8, x | 3);
    a =3D ld(0x9);
    st(0x8, x | 0xab);
    st(0x9, a);

    st(0x8, x | 4);
    a =3D ld(0x9);
    st(0x8, 0xac);
    st(0x9, a);

    st(0x58, (ld(0x58) & ~0x10));

    st(0x54, on? (ld(0x54) | 0x8000): (ld(0x54) & ~0x8000));

    exit(0);
}

