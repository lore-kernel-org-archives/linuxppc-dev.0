Can be simplified as

      switch (msg_type) {
      case OPAL_MSG_EPOW:
              pr_info("EPOW msg received. Powering off system\n");
              break;

      case OPAL_MSG_DPO:
              pr_info("DPO msg received. Powering off system\n");
              break;
      default:
               pr_err("Unknown message type %lu\n", msg_type);
               return;
