+static void
+cpci690_reset_board(void)
+{
+	unsigned long i = 10000;
+
+	__cli();
+
+	/* set exception prefix high - to the prom */
+	_nmask_and_or_msr(0, MSR_IP);
+
+	out_8((u8 *)(board_reg_base + CPCI690_SW_RESET), 0x11);
+
+	while ( i != 0 ) i++;
+	panic("restart failed\n");
+}
+
+static void
+cpci690_restart(char *cmd)
+{
+	cpci690_reset_board();
+}
+
+static void
+cpci690_halt(void)
+{
+	__cli();
+	while (1);
+	/* NOTREACHED */
+}
