--- a/kernel/printk.c
+++ b/kernel/printk.c
@@ -903,39 +903,41 @@ static int syslog_print_all(char __user *buf, int size, bool clear)
 		if (clear_seq < log_first_seq) {
 			/* messages are gone, move to first available one */
 			clear_seq = log_first_seq;
