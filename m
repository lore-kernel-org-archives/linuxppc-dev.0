> +++ b/drivers/of/dynamic.c
> @@ -55,7 +55,7 @@ void __of_detach_node_sysfs(struct devic
>         /* only remove properties if on sysfs */
>         if (of_node_is_attached(np)) {
>                 for_each_property_of_node(np, pp)
