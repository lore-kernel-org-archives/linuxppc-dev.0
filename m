 arch/powerpc/boot/dts/mpc8349emitx-gp.dts     |  190 ++++
 arch/powerpc/configs/mpc834x_itx_gp_defconfig | 1422 +++++++++++++++++++++++++
 2 files changed, 1612 insertions(+), 0 deletions(-)

diff --git a/arch/powerpc/boot/dts/mpc8349emitx-gp.dts b/arch/powerpc/boot/dts/mpc8349emitx-gp.dts
new file mode 100644
index 0000000..2d2e8b6
--- /dev/null
+++ b/arch/powerpc/boot/dts/mpc8349emitx-gp.dts
